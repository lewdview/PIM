    },
    {
      "end": 95.69999694824219,
      "text": "Bulls on bulls, I'm big mess, goals, no goals for treatment",
      "start": 92.55999755859375
    },
    {
      "end": 98.94000244140625,
      "text": "I think I'm in the deep end, not the type to pretend",
