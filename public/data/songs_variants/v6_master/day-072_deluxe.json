e":0,"type":"tap","stage":5,"id":342},{"time":199.901,"lane":2,"type":"slide","holdDuration":0.558,"targetLane":1,"stage":5,"id":343}],"stages":[{"stage":1,"name":"Stage 1","difficulty":"EASY","startTime":0,"endTime":29.977,"noteCount":21},{"stage":2,"name":"Stage 2","difficulty":"MEDIUM","startTime":29.977,"endTime":71.146,"noteCount":58},{"stage":3,"name":"Stage 3","difficulty":"HARD","startTime":71.146,"endTime":115.949,"noteCount":75},{"stage":4,"name":"Stage 4","difficulty":"BRUTAL","startTime":115.949,"endTime":149.954,"noteCount":78},{"stage":5,"name":"FINAL STAGE","difficulty":"BRUTAL","startTime":149.954,"endTime":206.627,"noteCount":112}],"key":"C# major","genre":["Ballad","Ambient"],"difficultyLevel":5,"lyrics":"Don't Let Go Is it hard to go through the mud, baby? Is it hard for you? Is it really that hard to be true? Cause you'll find just a little truth changes all of the dust around you Is it really that hard to get caught in the rain, baby? Now the rain makes you feel low, but you gotta stand up and go I know the rain makes you feel low, but you gotta stand up and know You, baby, you Is it really that hard to get caught in the rain? I don't know if I've been up this high before And I sure as hell don't wanna go down Is it really that hard, baby, out in the rain? Is it really that hard, baby, to say my name? I hope you remember This wasn't easy, oh no But was it really that hard? Was it really that bad to you? I hope you know it's not Is it really that hard, baby, out in your rain? Is it so hard to think that this could be experience that guides you further? Oh, is it hard out in your rain, baby? With all your self-inflicted shame coming around again Blame is all we ever find, my friend","lyricsSegments":[{"end":6.039999961853027,"text":"Don't Let Go","start":0},{"end":35.15999984741211,"text":"Is it hard to go through the mud, baby?","start":30},{"end":43.34000015258789,"text":"Is it hard for you? Is it really that hard to be true?","start":36.900001525878906},{"end":51.939998626708984,"text":"Cause you'll find just a little truth changes all of the dust around you","start":44.459999084472656},{"end":57.939998626708984,"text":"Is it really that hard to get caught in the rain, baby?","start":51.939998626708984},{"end":64.94000244140625,"text":"Now the rain makes you feel low, but you gotta stand up and go","start":57.939998626708984},{"end":72.77999877929688,"text":"I know the rain makes you feel low, but you gotta stand up and know","start":65.58000183105469},{"end":78.94000244140625,"text":"You, baby, you","start":75.9800033569336},{"end":85.44000244140625,"text":"Is it really that hard to get caught in the rain?","start":79.83999633789062},{"end":93.08000183105469,"text":"I don't know if I've been up this high before","start":85.44000244140625},{"end":99.37999725341797,"text":"And I sure as hell don't wanna go down","start":93.77999877929688},{"end":107.18000030517578,"text":"Is it really that hard, baby, out in the rain?","start":100.5999984741211},{"end":115.12000274658203,"text":"Is it really that hard, baby, to say my name?","start":108.18000030517578},{"end":123.41999816894531,"text":"I hope you remember","start":118.91999816894531},{"end":129.22000122070312,"text":"This wasn't easy, oh no","start":124.69999694824219},{"end":133.1999969482422,"text":"But was it really that hard?","start":129.72000122070312},{"end":138.83999633789062,"text":"Was it really that bad to you?","start":133.1999969482422},{"end":146.10000610351562,"text":"I hope you know it's not","start":140.3800048828125},{"end":158.33999633789062,"text":"Is it really that hard, baby, out in your rain?","start":149.16000366210938},{"end":171.33999633789062,"text":"Is it so hard to think that this could be experience that guides you further?","start":160.4600067138672},{"end":180.4600067138672,"text":"Oh, is it hard out in your rain, baby?","start":173.86000061035156},{"end":193.86000061035156,"text":"With all your self-inflicted shame coming a