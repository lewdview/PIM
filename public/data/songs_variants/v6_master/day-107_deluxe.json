.68000030517578,"text":"Don't act like you ain't helped me put that bottle on the shelf","start":49.900001525878906},{"end":57.41999816894531,"text":"Been deep in every week and if you couldn't tell","start":53.68000030517578},{"end":59.599998474121094,"text":"They said teamwork makes it framework","start":57.41999816894531},{"end":62.13999938964844,"text":"And I asked for help","start":59.599998474121094},{"end":66,"text":"Help, yeah","start":64.4800033569336},{"end":72.31999969482422,"text":"You thought I'd take the blame for us to crumble","start":68.22000122070312},{"end":75.4000015258789,"text":"And go around like you ain't guilty","start":72.31999969482422},{"end":78.12000274658203,"text":"Of something already lost","start":75.4000015258789},{"end":79.95999908447266,"text":"The game that you've been running","start":78.12000274658203},{"end":82.62000274658203,"text":"Guess it's catching up to you","start":80.0199966430664},{"end":87.13999938964844,"text":"You think that you're so innocent","start":83.68000030517578},{"end":91.44000244140625,"text":"After all the shit that you did","start":87.87999725341797},{"end":95.0199966430664,"text":"I ain't an angel, you ain't heaven sent","start":91.44000244140625},{"end":98.72000122070312,"text":"Can't wash my hands of this, I had some help","start":95.0199966430664},{"end":102.41999816894531,"text":"It ain't like I can make this kind of mess all by myself","start":98.80000305175781},{"end":106.22000122070312,"text":"Don't act like you ain't helped me put that bottle on the shelf","start":102.41999816894531},{"end":109.94000244140625,"text":"Been deep in every week and if you couldn't tell","start":106.22000122070312},{"end":112.13999938964844,"text":"They said teamwork makes it framework","start":109.94000244140625},{"end":114.13999938964844,"text":"Can't wash my hands","start":112.13999938964844},{"end":119.12000274658203,"text":"Oh yeah, I had","start":117.13999938964844},{"end":123.54000091552734,"text":"You know","start":122.13999938964844},{"end":126.12000274658203,"text":"I had some help","start":124.0999984741211},{"end":133.1999969482422,"text":"It takes two to break a heart in two","start":127.77999877929688},{"end":140.13999938964844,"text":"You blame me and baby I blame you","start":135.39999389648438},{"end":143.66000366210938,"text":"Hey, it's the truth, I had some help","start":141.39999389648438},{"end":147.3800048828125,"text":"Made this kind of mess all by myself","start":144.8000030517578},{"end":151.1999969482422,"text":"Don't act like you ain't helped me put that bottle on the shelf","start":147.52000427246094},{"end":154.89999389648438,"text":"Been deep in every week and if you couldn't tell","start":151.33999633789062},{"end":157.16000366210938,"text":"They said teamwork makes it framework","start":154.89999389648438},{"end":158.66000366210938,"text":"And I asked for help","start":157.16000366210938},{"end":163.8800048828125,"text":"I asked for help with you, baby","start":161.0800018310547},{"end":168.3800048828125,"text":"I asked for help with you","start":164.86000061035156},{"end":170.8000030517578,"text":"And now I ain't","start":168.3800048828125},{"end":173.72000122070312,"text":"Never going back again, bro","start":170.8000030517578}],"unlock":{"card":"card-107","fragments":10},"chartVersion":"v6_deluxe","chartReport":{"version":"v6_deluxe","bpm":128.37,"catalogBpm":64,"tempoConfidence":0.97,"beats":382,"bars":95,"repeatedBars":39,"povTimes":[60.79,135.802],"typeCounts":{"swipe":29,"tap":244,"hold":20,"accent":7,"slide":15,"hold-swipe":16,"lift":14,"zigzag":5,"mine":9,"remix":2,"break":4},"ms":353},"deluxe":true,"timingProfile":"elite"}