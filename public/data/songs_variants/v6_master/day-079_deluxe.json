":5,"id":575},{"time":219.304,"lane":0,"type":"tap","stage":5,"id":576},{"time":219.434,"lane":2,"type":"tap","stage":5,"id":577}],"stages":[{"stage":1,"name":"Stage 1","difficulty":"EASY","startTime":0,"endTime":32.253,"noteCount":23},{"stage":2,"name":"Stage 2","difficulty":"MEDIUM","startTime":32.253,"endTime":84.695,"noteCount":101},{"stage":3,"name":"Stage 3","difficulty":"HARD","startTime":84.695,"endTime":116.959,"noteCount":73},{"stage":4,"name":"Stage 4","difficulty":"BRUTAL","startTime":116.959,"endTime":177.459,"noteCount":241},{"stage":5,"name":"FINAL STAGE","difficulty":"BRUTAL","startTime":177.459,"endTime":222,"noteCount":140}],"key":"C major","genre":["Alternative","Indie"],"difficultyLevel":9,"lyrics":"The moment I'm without you, got me swollen in the gravity of no gravity And the moment I'm without you, it's like I'm looking for a shadow Of the life birthed now I never meant to do anything or believe that I never thought you could be my reasoning for the break I hope I see you down the road with the sun when he's lost in your life I swear to God it's not here, but it is I can feel it coming again The end is hard, the end is hard, the end is hard to hear The end is hard, the end is hard, but you're making it that And then you tell yourself lies, that brings you back right to this Yeah, fuck you, you know So what started all of this was a fuck It's like Big Bang Now I don't remember life before your name And now you're into all my stuff, like are you insane? I know what the fuck you're about now It's a plain game, you're not strong enough for your own thoughts I know, I know, you know It's your life birthed, fucking up my mind It's your life birthed, fucking up design You can only make a slate come to another To become real you have to fight and break down one another Now I keep giving you shot after shot Now I keep asking Will you be okay with me tomorrow? There's too many opportunities man You made your choice Cause every time I look at you It just reminds me of the thing I wish that I could have been I'm sorry but I gotta move on And if I gotta take a car If I gotta take a child It'll fuck up my brain But I'll do it for the sense that I'm just as Self-sufficient to be a team thing But we only wanna play the mean thing I can feel your life birthed from here over here I can feel that from clear over here What are you gonna give? What are you gonna give up the fight and come back? And do what's right tonight? What are you gonna give up that fight? I guess never, fuck neither will I, let's go Walk, walk Wouldn't want it any other way Ares","lyricsSegments":[{"end":22.3799991607666,"text":"The moment I'm without you, got me swollen in the gravity of no gravity","start":13.579999923706055},{"end":29.739999771118164,"text":"And the moment I'm without you, it's like I'm looking for a shadow","start":22.3799991607666},{"end":32.97999954223633,"text":"Of the life birthed now","start":29.739999771118164},{"end":40,"text":"I never meant to do anything or believe that","start":35.459999084472656},{"end":47.779998779296875,"text":"I never thought you could be my reasoning for the break","start":40},{"end":54.380001068115234,"text":"I hope I see you down the road with the sun when he's lost in your life","start":47.779998779296875},{"end":59.380001068115234,"text":"I swear to God it's not here, but it is","start":54.380001068115234},{"end":63.380001068115234,"text":"I can feel it coming again","start":60.540000915527344},{"end":68,"text":"The end is hard, the end is hard, the end is hard to hear","start":64.0999984741211},{"end":73.08000183105469,"text":"The end is hard, the end is hard, but you're making it that","start":68},{"end":81.19999694824219,"text":"And then you tell yourself lies, that brings you back right to this","start":73.4000015258789},{"end":86.73999786376953,"text":"Yeah, fuck you, you know","start":83.81999969482422},{"end":89.0999984741211,"text":"So what started all of this was a fuck","start":86.87999725341797},{"end":90.81999969482422,"text":"It's like Big Bang","start":89.62000274658203},{"end":94.0999984741211,"text":"Now I don't remember life before your name","start":91.73999786376953},{"end":96.63999938964844,"text":"And now you're into all my stuff, like are you insane?","start":94.12000274658203},{"end":102.72000122070312,"text":"I know what the fuck you're about now","start":97.4000015258789},{"end":109.55999755859375,"text":"It's a plain game, you're not strong enough for your own thoughts","start":104.0199966430664},{"end":113.55999755859375,"text":"I know, I know, you know","start":109.55999755859375},{"end":119.87999725341797,"text":"It's your life birthed, fucking up my mind","start":115.86000061035156},{"end":123.83999633789062,"text":"It's your life birthed, fucking up design","start":120},{"end":128.1999969482422,"text":"You can only make a slate come to another","start":123.87999725341797},{"end":134.17999267578125,"text":"To become real you have to fight and break down one another","start":128.1999969482422},{"end":139.0800018310547,"text":"Now I keep giving you shot after shot","start":135},{"end":142.32000732421875,"text":"Now I keep asking","start":139.25999450683594},{"end":144.83999633789062,"text":"Will you be okay with me tomorrow?","start":142.82000732421875},{"end":146.75999450683594,"text":"There's too many opportunities man","start":145.55999755859375},{"end":148.6199951171875,"text":"You made your choice","start":146.75999450683594},{"end":151,"text":"Cause every time I look at you","start":148.6199951171875},{"end":155.5800018310547,"text":"It just reminds me of the thing I wish that I could have been","start":151},{"end":159.5,"text":"I'm sorry but I gotta move on","start":156.55999755859375},{"end":162.05999755859375,"text":"And if I gotta take a car","start":159.5},{"end":165.94000244140625,"text":"If I gotta take a child","start":163.24000549316406},{"end":167.67999267578125,"text":"It'll fuck up my brain","start":165.94000244140625},{"end":171.75999450683594,"text":"But I'll do it for the sense that I'm just as","start":167.67999267578125},{"end":176.72000122070312,"text":"Self-sufficient to be a team thing","start":171.9199981689453},{"end":180.75999450683594,"text":"But we only wanna play the mean thing","start":176.72000122070312},{"end":188.55999755859375,"text":"I can feel your life birthed from here over here","start":182.24000549316406},{"end":199.82000732421875,"text":"I can feel that from clear over here","start":192.74000549316406},{"end":200.83999633789062,"text":"What are you gonna give?","start":199.82000732421875},{"end":203.27999877929688,"text":"What are you gonna give up the fight and come back?","start":200.83999633789062},{"end":207.17999267578125,"text":"And do what's right tonight?","start":203.39999389648438},{"end":210.47999572753906,"text":"What are you gonna give up that fight?","start":208.77999877929688},{"end":213.0399932861328,"text":"I guess never, fuck neither will I, let's go","start":210.9600067138672},{"end":216.0800018310547,"text":"Walk, walk","start":215.0399932861328},{"end":218.8000030517578,"text":"Wouldn't want it any other way","start":216.97999572753906},{"end":219.5399932861328,"text":"Ares","start":219.02000427246094}],"unlock":{"card":"card-79","fragments":10},"chartVersion":"v6_deluxe","chartReport":{"version":"v6_deluxe","bpm":119.4,"catalogBpm":131,"tempoConfidence":0,"beats":437,"bars":109,"repeatedBars":64,"povTimes":[84.695,177.459],"typeCounts":{"hold":29,"tap":395,"swipe":53,"slide":19,"hold-swipe":14,"lift":28,"accent":11,"mine":23,"remix":2,"break":4},"ms":498},"deluxe":true,"timingProfile":"elite"}