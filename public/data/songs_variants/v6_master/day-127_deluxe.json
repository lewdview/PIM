1},{"end":92.81999969482422,"text":"I just want a place of real unity","start":89.0999984741211},{"end":95.18000030517578,"text":"Just take that right back away","start":92.81999969482422},{"end":99.13999938964844,"text":"And take the violence away from me","start":96.08000183105469},{"end":102.4000015258789,"text":"Oh, you are just not it","start":99.13999938964844},{"end":107.58000183105469,"text":"You want to be here and I'm sorry","start":102.4000015258789},{"end":111.69999694824219,"text":"I gave you any idea","start":108.16000366210938},{"end":115.4800033569336,"text":"But I don't need it, you don't know me","start":112},{"end":118.4000015258789,"text":"But you probably need me, I'm sorry","start":115.58000183105469},{"end":121.27999877929688,"text":"Spirit, I can't take no more","start":118.4000015258789},{"end":125.66000366210938,"text":"The kid is gone, he's gone","start":121.27999877929688},{"end":127.69999694824219,"text":"Oh, it's a beast, go sing","start":125.66000366210938},{"end":129.5,"text":"Get over it, go back","start":127.69999694824219},{"end":131.0800018310547,"text":"That's what you're owed","start":129.5},{"end":133,"text":"And I make it what I know","start":131.0800018310547},{"end":135.77999877929688,"text":"But it's so hard to deny","start":133},{"end":138.77999877929688,"text":"Genius inside, genius around","start":135.77999877929688},{"end":141.10000610351562,"text":"But you just gotta understand","start":138.77999877929688},{"end":143.25999450683594,"text":"Don't want you around","start":141.44000244140625},{"end":152.3800048828125,"text":"Don't want you around","start":151.0399932861328}],"unlock":{"card":"card-127","fragments":10},"chartVersion":"v6_deluxe","chartReport":{"version":"v6_deluxe","bpm":144.31,"catalogBpm":71,"tempoConfidence":0.81,"beats":361,"bars":90,"repeatedBars":44,"povTimes":[56.517,119.409],"typeCounts":{"hold":26,"tap":214,"swipe":40,"slide":15,"hold-swipe":16,"lift":20,"mine":10,"accent":3,"break":4,"remix":2,"z